# Territory Chaos
GAME_ENV=dev
GAME_PUBLIC_URL=http://localhost:5173
REALTIME_URL=ws://localhost:3000

# Durable room / reconnect state (required before multi-instance realtime is production-ready)
REDIS_URL=

# Territory skin storage
# Development: local
# Production: vercel-blob
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads/

# Vercel Blob server-only secret. Required when STORAGE_PROVIDER=vercel-blob.
# Never expose this through VITE_* or client-side code.
BLOB_READ_WRITE_TOKEN=

# Upload safety ceilings
MAX_UPLOAD_SIZE=3145728
MAX_UPLOAD_DIMENSION=4096
OPTIMIZED_SKIN_DIMENSION=1024

# Protocol/rate limits
MAX_CHAT_MESSAGE_LENGTH=280
MAX_WS_MESSAGE_SIZE=65536
CHAT_MESSAGES_PER_10S=6
GAME_ACTIONS_PER_SECOND=30

# Optional deployment metadata exposed by the server only where appropriate
SOURCE_CODE_URL=https://github.com/hexonnfr-ops/test
GIT_COMMIT=DEV
